--==================================================
-- DRAG GENÉRICO
--==================================================

local function HacerArrastrable(Objeto, MoverObjeto)

	local Arrastrando = false
	local Inicio
	local PosicionInicial

	MoverObjeto = MoverObjeto or Objeto

	MoverObjeto.InputBegan:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then

			Arrastrando = true
			Inicio = Input.Position
			PosicionInicial = Objeto.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(Input)

		if not Arrastrando then
			return
		end

		if Input.UserInputType ~= Enum.UserInputType.MouseMovement
			and Input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		local Delta = Input.Position - Inicio

		Objeto.Position = UDim2.new(
			PosicionInicial.X.Scale,
			PosicionInicial.X.Offset + Delta.X,
			PosicionInicial.Y.Scale,
			PosicionInicial.Y.Offset + Delta.Y
		)
	end)

	UserInputService.InputEnded:Connect(function(Input)

		if Input.UserInputType == Enum.UserInputType.MouseButton1
			or Input.UserInputType == Enum.UserInputType.Touch then

			Arrastrando = false
		end
	end)
end

-- Mover panel usando +
HacerArrastrable(Panel, MoverPanel)

-- Mover burbuja desde cualquier parte
HacerArrastrable(Burbuja)

--==================================================
-- MOVIMIENTO
--==================================================

RunService.RenderStepped:Connect(function()

	if not ACTIVADO then
		return
	end

	local Character, Humanoid, Root = ObtenerPersonaje()

	if not Humanoid or not Root or Humanoid.Health <= 0 then
		return
	end

	local Camera = workspace.CurrentCamera

	if not Camera then
		return
	end

	local MoveDirection = Humanoid.MoveDirection

	if MoveDirection.Magnitude < 0.05 then
		return
	end

	local CameraRight = Camera.CFrame.RightVector
	local CameraForward = Camera.CFrame.LookVector

	local Right = Vector3.new(
		CameraRight.X,
		0,
		CameraRight.Z
	)

	local Forward = Vector3.new(
		CameraForward.X,
		0,
		CameraForward.Z
	)

	if Right.Magnitude < 0.01
		or Forward.Magnitude < 0.01 then
		return
	end

	Right = Right.Unit
	Forward = Forward.Unit

	local LateralAmount = MoveDirection:Dot(Right)
	local ForwardAmount = MoveDirection:Dot(Forward)

	-- SOLO modifica el movimiento lateral.
	if math.abs(LateralAmount) > math.abs(ForwardAmount)
		and math.abs(LateralAmount) > 0.35 then

		local SideDirection =
			Right * math.sign(LateralAmount)

		local CurrentVelocity =
			Root.AssemblyLinearVelocity

		local NewLateralVelocity =
			SideDirection
			* VELOCIDAD_LATERAL
			* math.abs(LateralAmount)

		Root.AssemblyLinearVelocity = Vector3.new(
			NewLateralVelocity.X,
			CurrentVelocity.Y,
			NewLateralVelocity.Z
		)

		-- Giro instantáneo
		Root.CFrame = CFrame.lookAt(
			Root.Position,
			Root.Position + SideDirection
		)

	else

		-- Movimiento normal hacia delante/atrás.
		local Direction = Vector3.new(
			MoveDirection.X,
			0,
			MoveDirection.Z
		)

		if Direction.Magnitude > 0.01 then

			Direction = Direction.Unit

			Root.CFrame = CFrame.lookAt(
				Root.Position,
				Root.Position + Direction
			)

		end
	end
end)

